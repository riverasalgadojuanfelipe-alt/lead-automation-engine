# --- LLM ---
# mock = sin API key, determinista (por defecto). anthropic | openai = LLM real.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=            # obligatorio si usas anthropic u openai (pon el modelo que tengas disponible)

# --- Webhook ---
# Si se define, el webhook exige la cabecera X-Signature = HMAC-SHA256(secret, body) en hex.
WEBHOOK_SECRET=

# --- Correo ---
# file = escribe los correos en data/outbox (por defecto). smtp = envío real.
EMAIL_SENDER=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ventas@tu-dominio-de-envio.com

# --- Almacenamiento ---
DB_PATH=data/crm.db
OUTBOX_DIR=data/outbox

# --- Pantalla de demo (http://localhost:8000/) ---
# 1 = activa la página web y los endpoints /demo/* (sin firma; SOLO para uso local). 0 = apagada.
DEMO_UI=1
